DATABASE_URL="postgresql://temellodev:temellodev123@127.0.0.1:5432/correiosentrega_dev?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

JWT_SECRET="correios-entregas-dev-jwt-secret-32chars"
JWT_REFRESH_SECRET="correios-entregas-dev-refresh-secret-32"

CORREIOS_CWS_URL="https://api.correios.com.br"
CORREIOS_CWS_USERNAME=""
CORREIOS_CWS_ACCESS_CODE=""
CORREIOS_CWS_CONTRACT=""
CORREIOS_CWS_CARTAO_POSTAGEM=""

VIACEP_URL="https://viacep.com.br/ws"

OSRM_URL="http://127.0.0.1:5001"
VROOM_URL="http://127.0.0.1:3000"
PYVRP_URL="http://127.0.0.1:8000"

PORT=3002
NODE_ENV=development
FRONTEND_URL="http://localhost:5181"

UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# WhatsApp Hub (delivyo-services/ms-whatsapp)
WHATSAPP_HUB_BASE_URL="http://host.docker.internal/services/whatsapp"
WHATSAPP_HUB_API_PREFIX="/api/comunicacao"
WHATSAPP_HUB_TIMEOUT_MS=10000
WHATSAPP_HUB_TENANT_ID="CORREIOS"

# ── Chatwoot SSO ─────────────────────────────────────────
CHATWOOT_BASE_URL="https://chatwoot.delivyodev.com"
CHATWOOT_PLATFORM_TOKEN=""
CHATWOOT_API_TOKEN_CORREIOS=""
CHATWOOT_ACCOUNT_FOR_CORREIOS=7

# ── LLM Providers (opcional) ─────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# ── Proxy LGPD ───────────────────────────────────────────
PROXY_ENCRYPTION_KEY=""

# ── App URL (para webhook callbacks) ─────────────────────
APP_URL="http://localhost:3002"
DEFAULT_UNIDADE_NOME="CorreiosEntregas"

# ── Entregas mediadas ───────────────────────────────────
# Chave AES-256-GCM dos segredos dos canais Prosio: 64 hex ou base64 de 32 bytes
# (ex.: `openssl rand -base64 32`). Obrigatória para o cadastro de canais.
ENTREGAS_CRYPTO_KEY=""
# Bearer da API pública do Seu Rastreio.
SEU_RASTREIO_TOKEN=""
# Origem do Seu Rastreio (padrão https://seurastreio.com.br; os testes apontam para o falso).
# SEU_RASTREIO_URL=""
# "true" só quando o Prosio aceitar os campos R1/R2/R3/R5/P1 da mediação
# (firstContact, resumo, respondBy, unidadeRef e PATCH dos fatos). Hoje a
# abertura real é strict e recusa campos extras com 422.
PROSIO_MEDIACAO_EXTENSOES="false"
# Limite por minuto (por IP) das rotas de entrada do Prosio (webhook e ações de botão). Padrão 600.
# ENTREGAS_PROSIO_LIMITE_POR_MINUTO="600"
# Domínio em que o Chatwoot é embutido na tela Atendimento (ex.: correiosdev.com). Vai como
# `dominio` no pedido de sessão ao Prosio, que precisa tê-lo na lista de domínios de embed.
# Vazio: o Prosio devolve a URL padrão dele (chat.prosio.com.br), que recusa o iframe.
ATENDIMENTO_DOMINIO=""

# ── Captura do rótulo (app do carteiro) ─────────────────
# Diretório das fotos (no Docker, o volume correios_fotos em /data/fotos).
FOTOS_DIR="/data/fotos"
# Extrator: "google" (Gemini via AI SDK) ou "fake" (testes/E2E, responde pelas fixtures).
CAPTURA_AI_PROVIDER="google"
CAPTURA_AI_MODEL="gemini-3.1-flash-lite"
# Sem chave, a extração fica indisponível e toda captura vai para "Para conferir".
CAPTURA_AI_API_KEY=""
# Retenção das fotos: dias depois do dia do pacote e máximo absoluto desde a captura.
FOTO_RETENCAO_DIAS_APOS_FIM="30"
FOTO_RETENCAO_MAX_DIAS="90"

# ── Testes de integração ────────────────────────────────
# Banco DEDICADO: o globalSetup recusa nomes que não terminem em _test,
# apaga o schema e reaplica as migrations a cada execução. Nunca o banco de dev.
TEST_DATABASE_URL=""
# Redis dos testes (opcional; sobrescreve REDIS_URL nos testes de integração).
# O índice do banco na URL é respeitado pelas filas (ex.: redis://127.0.0.1:6379/5).
TEST_REDIS_URL=""
