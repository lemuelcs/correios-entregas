// api/prisma/schema.prisma
// PostgreSQL 18 + TimescaleDB

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— ENUMS ————————————————————————————————————————————————————

enum TipoUnidade {
  CDD
  CEE
  HIBRIDA
}

enum ModeloTriagem {
  MANUAL
  PTL
  ADTA
}

enum Role {
  GESTAO
  UNIDADE
  CARTEIRO
  DESTINATARIO
}

enum ModalEntrega {
  A_PE
  BICICLETA
  BICICLETA_ELETRICA
  MOTOCICLETA
  CARRO
  FURGAO
  VAN
  SPRINTER
}

enum TipoUnitizador {
  BAG
  SACOLA
  CARRINHO
  CAIXETA
  CDL
  CAF
  VEICULO
}

enum StatusUnitizador {
  DISPONIVEL
  EM_USO
  EM_MANUTENCAO
  INATIVO
}

enum StatusVeiculo {
  DISPONIVEL
  EM_ROTA
  MANUTENCAO
  INATIVO
}

enum StatusObjeto {
  AGUARDANDO_CHEGADA
  RECEBIDO_UNIDADE
  EM_CONFERENCIA
  TRIADO
  UNITIZADO
  DISPONIVEL_COLETA
  COLETADO_CARTEIRO
  EM_ROTA
  ENTREGUE
  TENTATIVA_SEM_ATENDIMENTO
  DEVOLVIDO_UNIDADE
  AGUARDANDO_RETIRADA
  DEVOLVIDO_REMETENTE
  AVARIADO
  EXTRAVIADO
  CANCELADO
}

enum StatusRota {
  CRIADA
  DISPONIVEL
  COLETADA
  EM_ANDAMENTO
  CONCLUIDA
  FINALIZADA
}

enum StatusParada {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum ModoOtimizacao {
  ABSOLUTO
  LARGE_VAN
  BALANCEADO
}

enum SolverUsado {
  VROOM
  PYVRP
}

enum TipoAtorEvento {
  CARTEIRO
  GESTOR
  SISTEMA
  DESTINATARIO
}

enum ServicoAdicional {
  AR_FISICO
  AR_ELETRONICO
  AR_DIGITAL
  MAO_PROPRIA
}

enum TipoInteracao {
  REAGENDAR
  AUTORIZAR_TERCEIRO
  REDIRECIONAR
  MANTER_AGENCIA
  CONTATAR_CARTEIRO
}

enum StatusInteracao {
  PENDENTE
  PROCESSADA
  REJEITADA
}

enum GeocodeAccuracy {
  ROOFTOP
  INTERPOLATED
  APPROXIMATE
}

// ——— MODELS ———————————————————————————————————————————————————

model SuperintendenciaEstadual {
  id        String   @id @default(uuid())
  nome      String
  sigla     String   @unique
  cidade    String
  uf        String   @db.Char(2)
  isSede    Boolean  @default(false)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidades Unidade[]

  @@map("superintendencias_estaduais")
}

model Unidade {
  id            String        @id @default(uuid())
  codigo        String        @unique
  mcu           String?       @unique
  nome          String
  tipo          TipoUnidade
  seId          String?
  logradouro    String
  numero        String
  complemento   String?
  bairro        String
  cidade        String
  uf            String        @db.Char(2)
  cep           String        @db.Char(8)
  latitude      Decimal       @db.Decimal(10, 7)
  longitude     Decimal       @db.Decimal(10, 7)
  faixasCep     Json          @default("[]")
  modeloTriagem ModeloTriagem @default(MANUAL)
  configTriagem Json          @default("{}")
  horarioAbre  String? // "08:00"
  horarioFecha String? // "18:00"
  ativa         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  se          SuperintendenciaEstadual? @relation(fields: [seId], references: [id])
  usuarios    Usuario[]
  carteiros   Carteiro[]
  objetos     Objeto[]
  rotas       Rota[]
  unitizadores Unitizador[]
  previsoes   VolumePrevisao[]

  // WPP-PILOT relations
  wppPilotConfig WppPilotConfig?

  lockers             LockerCorreios[]
  fluxoConfigs        FluxoConfig[]
  fluxosEntrega       FluxoEntregaDestinatario[]

  @@map("unidades")
}

model Usuario {
  id                       String   @id @default(uuid())
  unidadeId                String?
  cpf                      String?  @unique
  email                    String?  @unique
  matricula                String?  @unique
  senha                    String
  nome                     String
  role                     Role
  telefoneCelular          String?
  telefoneComercial        String?
  endResidencialCidade     String?
  endResidencialUf         String?  @db.Char(2)
  endResidencialCep        String?  @db.Char(8)
  endResidencialLogradouro String?
  endResidencialNumero     String?
  endResidencialComplemento String?
  ativo                    Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  unidade       Unidade?       @relation(fields: [unidadeId], references: [id])
  carteiro      Carteiro?
  refreshTokens RefreshToken[]
  eventos       ObjetoEvento[]

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId String
  expiresAt DateTime
  revogado  Boolean  @default(false)
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("refresh_tokens")
}

model Carteiro {
  id              String       @id @default(uuid())
  usuarioId       String       @unique
  unidadeId       String
  matricula       String       @unique
  modalPrincipal  ModalEntrega @default(A_PE)
  cnh             String?
  ativo           Boolean      @default(true)
  familiaridadeH3 Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  unidade Unidade  @relation(fields: [unidadeId], references: [id])
  pontos  PontoDia[]
  rotas   Rota[]

  // WPP-PILOT relations
  wppPilotSessions  WppPilotSession[]
  wppProxySessions  WppProxyPilotSession[]
  wppInsucessoFluxo WppInsucessoFluxo[]

  @@map("carteiros")
}

model PontoDia {
  id          String    @id @default(uuid())
  carteiroId  String
  data        DateTime  @db.Date
  horaEntrada DateTime?
  horaSaida   DateTime?
  presente    Boolean   @default(false)
  observacao  String?
  createdAt   DateTime  @default(now())

  carteiro Carteiro @relation(fields: [carteiroId], references: [id])

  @@unique([carteiroId, data])
  @@map("pontos_dia")
}

model Objeto {
  id                   String             @id @default(uuid())
  codigoRastreio       String             @unique
  servicoCodigo        String             @db.Char(2)
  unidadeId            String
  destinatarioNome     String
  destinatarioCpf      String?
  destinatarioEmail    String?
  destinatarioTelefone String?
  cepDestino           String             @db.Char(8)
  logradouro           String
  numero               String
  complemento          String?
  bairro               String
  cidade               String
  uf                   String             @db.Char(2)
  latitude             Decimal?           @db.Decimal(10, 7)
  longitude            Decimal?           @db.Decimal(10, 7)
  geocodeAccuracy      GeocodeAccuracy?
  remetenteNome        String
  remetenteCpfCnpj     String?
  pesoGramas           Int
  larguraCm            Decimal?           @db.Decimal(8, 2)
  alturaCm             Decimal?           @db.Decimal(8, 2)
  comprimentoCm        Decimal?           @db.Decimal(8, 2)
  cubagem              Decimal?           @db.Decimal(10, 3)
  servicosAdicionais   ServicoAdicional[]
  notaFiscalChave      String?            @db.Char(44)
  notaFiscalNumero     String?
  statusAtual          StatusObjeto       @default(AGUARDANDO_CHEGADA)
  unitizadorId         String?
  rotaId               String?
  stopSequence         Int?
  distritoCodigo       String?
  tentativasEntrega    Int                @default(0)
  maxTentativas        Int                @default(2)
  diasGuarda           Int                @default(7)
  dataLimiteGuarda     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  unidade    Unidade       @relation(fields: [unidadeId], references: [id])
  unitizador Unitizador?   @relation(fields: [unitizadorId], references: [id])
  rota       Rota?         @relation(fields: [rotaId], references: [id])
  eventos    ObjetoEvento[]
  nps        NpsResposta?
  interacoes InteracaoObjeto[]
  fluxosEntrega FluxoEntregaDestinatario[]

  @@index([codigoRastreio])
  @@index([unidadeId, statusAtual])
  @@index([cepDestino])
  @@index([rotaId])
  @@map("objetos")
}

model Unitizador {
  id             String           @id @default(uuid())
  codigo         String           @unique
  qrCode         String           @unique
  tipo           TipoUnitizador
  unidadeId      String
  larguraCm      Decimal?         @db.Decimal(8, 2)
  alturaCm       Decimal?         @db.Decimal(8, 2)
  profundidadeCm Decimal?         @db.Decimal(8, 2)
  volumeLitros   Decimal?         @db.Decimal(10, 3)
  capacidadeKg   Decimal?         @db.Decimal(8, 2)
  placa          String?
  modeloVeiculo  String?
  modal          ModalEntrega?
  statusVeiculo  StatusVeiculo?
  statusAtual    StatusUnitizador @default(DISPONIVEL)
  localizacaoAtual Json           @default("{\"tipo\":\"ESPACO_FISICO\",\"referencia\":\"\"}")
  rotaAtualId    String?
  parentId       String?
  ativo          Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  unidade         Unidade              @relation(fields: [unidadeId], references: [id])
  objetos         Objeto[]
  historico       UnitizadorHistorico[]
  rotaComoVeiculo Rota?                @relation("VeiculoRota")

  @@index([unidadeId])
  @@index([codigo])
  @@map("unitizadores")
}

model UnitizadorHistorico {
  id                  String           @id @default(uuid())
  unitizadorId        String
  statusAnterior      StatusUnitizador
  statusNovo          StatusUnitizador
  localizacaoAnterior Json
  localizacaoNova     Json
  ocorridoEm         DateTime         @default(now())
  atorId              String
  motivo              String?

  unitizador Unitizador @relation(fields: [unitizadorId], references: [id])

  @@index([unitizadorId])
  @@map("unitizadores_historico")
}

model TransferenciaCarga {
  id         String   @id @default(uuid())
  origemIds  Json
  destinoIds Json
  objetoIds  Json
  tipo       String
  ocorridoEm DateTime @default(now())
  atorId     String
  observacao String?

  @@map("transferencias_carga")
}

model Rota {
  id                  String         @id @default(uuid())
  codigo              String         @unique
  unidadeId           String
  carteiroId          String
  veiculoId           String         @unique
  statusAtual         StatusRota     @default(CRIADA)
  modeloTriagem       ModeloTriagem
  modoOtimizacao      ModoOtimizacao @default(ABSOLUTO)
  solverUsado         SolverUsado    @default(VROOM)
  totalParadas        Int            @default(0)
  totalObjetos        Int            @default(0)
  totalEntregues      Int            @default(0)
  totalInsucessos     Int            @default(0)
  totalPnovs          Int            @default(0)
  distanciaEstimadaKm Decimal?       @db.Decimal(8, 2)
  duracaoEstimadaMin  Int?
  horarioDespachoAlvo DateTime?
  iniciadoEm          DateTime?
  concluidoEm         DateTime?
  finalizadoEm        DateTime?
  retornoEstimado     DateTime?
  retornoProjetado    DateTime?
  posicaoEstacao      String?
  unitizadorIds       Json           @default("[]")
  solverJobId         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  unidade   Unidade    @relation(fields: [unidadeId], references: [id])
  carteiro  Carteiro   @relation(fields: [carteiroId], references: [id])
  veiculo   Unitizador @relation("VeiculoRota", fields: [veiculoId], references: [id])
  paradas   Parada[]
  objetos   Objeto[]
  sortPlan  SortPlan?
  snapshots RitmoSnapshot[]

  // WPP-PILOT relations
  wppProxySessions  WppProxyPilotSession[]
  wppInsucessoFluxo WppInsucessoFluxo[]

  @@index([unidadeId, statusAtual])
  @@index([carteiroId])
  @@map("rotas")
}

model Parada {
  id                String       @id @default(uuid())
  rotaId            String
  sequencia         Int
  latitude          Decimal      @db.Decimal(10, 7)
  longitude         Decimal      @db.Decimal(10, 7)
  cep               String       @db.Char(8)
  logradouro        String?
  statusAtual       StatusParada @default(PENDENTE)
  estimativaChegada DateTime?
  chegadaReal       DateTime?
  saidaReal         DateTime?
  entregaAgrupada   Boolean      @default(false)
  totalObjetos      Int          @default(0)
  totalEntregues    Int          @default(0)
  totalInsucessos   Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  rota Rota @relation(fields: [rotaId], references: [id])

  @@index([rotaId])
  @@map("paradas")
}

model ObjetoEvento {
  id             String         @id @default(uuid())
  objetoId       String
  tipo           String
  descricao      String
  ocorridoEm     DateTime
  registradoEm   DateTime       @default(now())
  latitude       Decimal?       @db.Decimal(10, 7)
  longitude      Decimal?       @db.Decimal(10, 7)
  localDescricao String
  atorTipo       TipoAtorEvento
  atorId         String
  evidencias     Json?
  rotaId         String?
  stopSequence   Int?
  metadata       Json?

  objeto Objeto  @relation(fields: [objetoId], references: [id])
  ator   Usuario @relation(fields: [atorId], references: [id])

  @@index([objetoId])
  @@index([ocorridoEm])
  @@map("objetos_eventos")
}

model SortPlan {
  id          String        @id @default(uuid())
  rotaId      String        @unique
  unidadeId   String
  geradoEm    DateTime      @default(now())
  modelo      ModeloTriagem
  assignments Json          @default("[]")
  validado    Boolean       @default(false)

  rota Rota @relation(fields: [rotaId], references: [id])

  @@map("sort_plans")
}

model VolumePrevisao {
  id                 String   @id @default(uuid())
  unidadeId          String
  faixa              String
  quantidadeEstimada Int
  quantidadeChegou   Int      @default(0)
  data               DateTime @db.Date
  atualizadoEm       DateTime @updatedAt
  createdAt          DateTime @default(now())

  unidade Unidade @relation(fields: [unidadeId], references: [id])

  @@unique([unidadeId, faixa, data])
  @@map("volumes_previsao")
}

model NpsResposta {
  id             String   @id @default(uuid())
  objetoId       String   @unique
  destinatarioId String
  nota           Int
  categoria      String
  comentario     String?
  respondidoEm   DateTime @default(now())

  objeto Objeto @relation(fields: [objetoId], references: [id])

  @@map("nps_respostas")
}

model InteracaoObjeto {
  id             String          @id @default(uuid())
  objetoId       String
  destinatarioId String
  tipo           TipoInteracao
  dados          Json
  status         StatusInteracao @default(PENDENTE)
  criadoEm       DateTime        @default(now())
  processadoEm   DateTime?
  processadoPor  String?

  objeto Objeto @relation(fields: [objetoId], references: [id])

  @@index([objetoId])
  @@map("interacoes_objeto")
}

model GpsSnapshot {
  id         String   @id @default(uuid())
  rotaId     String
  carteiroId String
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  velocidade Decimal? @db.Decimal(5, 2)
  ocorridoEm DateTime @default(now())

  @@index([rotaId, ocorridoEm])
  @@map("gps_snapshots")
}

model RitmoSnapshot {
  id               String   @id @default(uuid())
  rotaId           String
  paradasFeitas    Int
  objetosEntregues Int
  sphAtual         Decimal  @db.Decimal(6, 2)
  retornoProjetado DateTime?
  ocorridoEm       DateTime @default(now())

  rota Rota @relation(fields: [rotaId], references: [id])

  @@index([rotaId, ocorridoEm])
  @@map("ritmo_snapshots")
}

model EnderecoGeocode {
  cep          String          @id @db.Char(8)
  logradouro   String
  bairro       String
  cidade       String
  uf           String          @db.Char(2)
  latitude     Decimal         @db.Decimal(10, 7)
  longitude    Decimal         @db.Decimal(10, 7)
  accuracy     GeocodeAccuracy
  fonte        String
  atualizadoEm DateTime        @updatedAt

  @@map("enderecos_geocode")
}

model ConfiguracaoGlobal {
  id        String   @id @default(uuid())
  chave     String   @unique
  valor     Json
  descricao String?
  updatedAt DateTime @updatedAt

  @@map("configuracao_global")
}

// ——— WPP-PILOT ENUMS —————————————————————————————————————————

enum WppParticipantType {
  CARTEIRO
  DESTINATARIO
  GESTAO
  UNIDADE
  UNKNOWN
}

enum WppConversationState {
  BOT_ACTIVE
  PROXY_ACTIVE
  DISPATCHER_ACTIVE
  CLOSED
  OPTED_OUT
}

enum WppProxyPilotStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum WppInsucessoStatus {
  AGUARDANDO_RESPOSTA
  RETORNO_HOJE
  REAGENDADO
  SEM_RESPOSTA
  SEM_TELEFONE
  ERRO_ENVIO
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum StatusFluxoEntrega {
  AGUARDANDO_RESPOSTA
  CONFIRMADO_PRESENCA
  ENTREGAR_VIZINHO
  REAGENDAR_AMANHA
  RETIRAR_AGENCIA
  RETIRAR_LOCKER
  EXPIRADO
}

// ——— WPP-PILOT MODELS ————————————————————————————————————————

// Configuracao da instancia Evolution API por Unidade
model WppPilotConfig {
  id           String  @id @default(uuid())
  unidadeId    String  @unique
  unidade      Unidade @relation(fields: [unidadeId], references: [id])

  instanceName String @unique
  phoneNumber  String
  unidadeNome  String @default("Unidade")

  // Locale/timezone
  locale   String @default("pt_BR")
  timezone String @default("America/Sao_Paulo")

  botEnabled       Boolean @default(true)
  proxyEnabled     Boolean @default(true)
  maxProxyHours    Int     @default(4)
  maxProxyMessages Int     @default(50)
  optOutKeywords   Json    @default("[\"PARAR\",\"SAIR\",\"STOP\"]")

  // LLM / IA
  llmEnabled Boolean @default(false)
  llmConfig  Json    @default("{}")

  connected     Boolean   @default(false)
  connectedAt   DateTime?
  lastWebhookAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      WppPilotSession[]
  proxySessions WppProxyPilotSession[]
  insucessos    WppInsucessoFluxo[]
  llmUsageLogs  LlmUsageLog[]

  @@map("wpp_pilot_config")
}

// Sessao de conversa — 1 por numero de telefone
model WppPilotSession {
  id           String         @id @default(uuid())
  instanceName String
  config       WppPilotConfig @relation(fields: [instanceName], references: [instanceName])

  phone           String             @default("")
  participantType WppParticipantType @default(UNKNOWN)
  carteiroId      String?
  carteiro        Carteiro?          @relation(fields: [carteiroId], references: [id])

  state         WppConversationState @default(BOT_ACTIVE)
  lastMessageAt DateTime?
  totalMessages Int                  @default(0)

  // Dispatcher
  dispatcherAtivo Boolean   @default(false)
  dispatcherNome  String?
  dispatcherSince DateTime?
  botSilenciado   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages           WppPilotMessage[]
  dispatcherSessions WppDispatcherSession[]

  @@unique([instanceName, phone])
  @@index([instanceName, state])
  @@map("wpp_pilot_sessions")
}

// Mensagens individuais
model WppPilotMessage {
  id        String          @id @default(uuid())
  sessionId String
  session   WppPilotSession @relation(fields: [sessionId], references: [id])

  waMessageId    String? @unique
  direction      String
  messageType    String
  content        String? @db.Text
  isProxied      Boolean @default(false)
  proxySessionId String?

  // Status de entrega (OUTBOUND via webhook messages.update)
  deliveryStatus String @default("SENT")

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([waMessageId])
  @@map("wpp_pilot_messages")
}

// Canal proxy anonimo carteiro <-> destinatario
model WppProxyPilotSession {
  id           String         @id @default(uuid())
  instanceName String
  config       WppPilotConfig @relation(fields: [instanceName], references: [instanceName])
  unidadeId    String

  carteiroPhone       String
  carteiroId          String?
  carteiro            Carteiro? @relation(fields: [carteiroId], references: [id])
  destinatarioPhoneEnc String   // AES-256-GCM: "ivHex:authTagHex:encHex"

  rotaId   String?
  rota     Rota?   @relation(fields: [rotaId], references: [id])
  paradaId String?

  status       WppProxyPilotStatus @default(ACTIVE)
  messageCount Int                 @default(0)
  expiresAt    DateTime
  endedAt      DateTime?
  endReason    String?

  createdAt DateTime             @default(now())
  auditLogs WppProxyPilotAudit[]

  @@index([instanceName, status])
  @@index([carteiroPhone])
  @@map("wpp_proxy_pilot_sessions")
}

// Audit log do proxy (apenas hash — LGPD)
model WppProxyPilotAudit {
  id             String               @id @default(uuid())
  proxySessionId String
  proxySession   WppProxyPilotSession @relation(fields: [proxySessionId], references: [id])

  direction   String
  messageHash String
  charCount   Int?
  createdAt   DateTime @default(now())

  @@index([proxySessionId])
  @@map("wpp_proxy_pilot_audit")
}

// Fluxo de insucesso com destinatario
model WppInsucessoFluxo {
  id           String         @id @default(uuid())
  instanceName String
  config       WppPilotConfig @relation(fields: [instanceName], references: [instanceName])
  unidadeId    String

  carteiroId    String
  carteiro      Carteiro @relation(fields: [carteiroId], references: [id])
  carteiroPhone String

  pacoteInsucessoId String
  rotaId            String?
  rota              Rota?   @relation(fields: [rotaId], references: [id])
  destinatarioPhone String?
  destinatarioNome  String?

  status WppInsucessoStatus @default(AGUARDANDO_RESPOSTA)

  mensagemEnviadaEm     DateTime?
  respostaRecebidaEm    DateTime?
  carteiroNotificadoEm  DateTime?
  expiresAt             DateTime
  respostaRaw           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instanceName, status])
  @@index([pacoteInsucessoId])
  @@index([carteiroPhone])
  @@map("wpp_insucesso_fluxo")
}

// Sessao de dispatcher humano numa conversa
model WppDispatcherSession {
  id           String @id @default(uuid())
  instanceName String
  unidadeId    String

  dispatcherId   String
  dispatcherNome String

  wppSessionId String
  wppSession   WppPilotSession @relation(fields: [wppSessionId], references: [id])

  ativo     Boolean   @default(true)
  entradaEm DateTime  @default(now())
  saidaEm   DateTime?

  mensagens WppDispatcherMsg[]

  @@index([wppSessionId, ativo])
  @@index([dispatcherId])
  @@map("wpp_dispatcher_sessions")
}

// Mensagens enviadas pelo dispatcher
model WppDispatcherMsg {
  id                  String               @id @default(uuid())
  dispatcherSessionId String
  dispatcherSession   WppDispatcherSession @relation(fields: [dispatcherSessionId], references: [id])

  waMessageId String? @unique
  content     String  @db.Text
  direction   String  @default("OUTBOUND")
  toPhone     String

  createdAt DateTime @default(now())

  @@index([dispatcherSessionId])
  @@map("wpp_dispatcher_msgs")
}

// Log de uso e custo LLM por unidade
model LlmUsageLog {
  id             String  @id @default(uuid())
  configId       String
  config         WppPilotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  conversationId String?

  provider     String  @db.VarChar(30)
  model        String  @db.VarChar(50)
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costUsd      Decimal @default(0) @db.Decimal(10, 6)
  latencyMs    Int     @default(0)

  useCase      String  @db.VarChar(50)
  success      Boolean @default(true)
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  @@index([configId, createdAt])
  @@index([provider, model])
  @@map("llm_usage_logs")
}

// ——— FLUXO ENTREGA MODELS ———————————————————————————————————

model LockerCorreios {
  id           String   @id @default(uuid())
  nome         String
  codigo       String   @unique
  logradouro   String
  numero       String
  bairro       String
  cidade       String
  uf           String   @db.Char(2)
  cep          String   @db.Char(8)
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  horarioAbre  String
  horarioFecha String
  ativo        Boolean  @default(true)
  unidadeId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unidade Unidade? @relation(fields: [unidadeId], references: [id])

  @@map("lockers_correios")
}

model FluxoEntregaDestinatario {
  id                String             @id @default(uuid())
  instanceName      String
  unidadeId         String
  objetoId          String
  destinatarioPhone String
  destinatarioNome  String?

  status            StatusFluxoEntrega @default(AGUARDANDO_RESPOSTA)

  mensagemEnviadaEm   DateTime?
  respostaRecebidaEm  DateTime?
  respostaRaw         String?
  opcaoEscolhida      String?
  expiresAt           DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objeto  Objeto  @relation(fields: [objetoId], references: [id])
  unidade Unidade @relation(fields: [unidadeId], references: [id])

  @@index([instanceName, status])
  @@index([objetoId])
  @@index([destinatarioPhone])
  @@map("fluxo_entrega_destinatario")
}

model FluxoConfig {
  id        String   @id @default(uuid())
  unidadeId String?
  codigo    String
  versao    Int      @default(1)
  ativo     Boolean  @default(true)
  definicao Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidade Unidade? @relation(fields: [unidadeId], references: [id])

  @@unique([unidadeId, codigo])
  @@map("fluxo_configs")
}
