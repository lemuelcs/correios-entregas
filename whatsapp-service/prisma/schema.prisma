// whatsapp-service/prisma/schema.prisma
// Microserviço de Comunicação WhatsApp (WPP-PILOT) - White Label Edition

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— ENUMS —————————————————————————————————————————

enum WppParticipantType {
  DRIVER       // Agente de entrega (Motorista/Carteiro)
  ADDRESSEE    // Destinatário
  ADMIN        // Gestor do Tenant
  STATION_MGR  // Gestor da Estação
  UNKNOWN
}

enum WppConversationState {
  BOT_ACTIVE
  PROXY_ACTIVE
  DISPATCHER_ACTIVE
  CLOSED
  OPTED_OUT
}

enum WppProxyPilotStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum StatusFluxoEntrega {
  AWAITING_RESPONSE
  CONFIRMED
  RESCHEDULED
  DECLINED
  EXPIRADO
}

// ——— MODELS ————————————————————————————————————————

// Configuração Multi-Tenant e Multi-Station
model WppPilotConfig {
  id           String  @id @default(uuid())
  tenantId     String  // ID da Empresa (Correios, Temelio, etc)
  stationId    String? @unique // ID da Estação/Unidade física

  instanceName String @unique
  phoneNumber  String
  
  // Nomenclatura Personalizada (Ex: {"unit": "CDD", "driver": "Carteiro"})
  terminology  Json    @default("{\"unit\": \"Estação\", \"driver\": \"Motorista\", \"pack\": \"Encomenda\"}")
  
  // Locale/timezone
  locale   String @default("pt_BR")
  timezone String @default("America/Sao_Paulo")

  botEnabled       Boolean @default(true)
  proxyEnabled     Boolean @default(true)
  maxProxyHours    Int     @default(4)
  optOutKeywords   Json    @default("[\"PARAR\",\"SAIR\",\"STOP\"]")

  // Inteligência em Cascata & White Label
  customMessages   Json    @default("{}") // Sobrescrita de textos do i18n
  flowDefinition   Json    @default("{}") // Configuração de menus e palavras-chave

  // LLM / IA (Nível 3 da cascata)
  llmEnabled Boolean @default(false)
  llmConfig  Json    @default("{}")

  connected     Boolean   @default(false)
  connectedAt   DateTime?
  lastWebhookAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      WppPilotSession[]
  proxySessions WppProxyPilotSession[]
  llmUsageLogs  LlmUsageLog[]

  @@map("wpp_pilot_config")
}

// Sessao de conversa — 1 por numero de telefone
model WppPilotSession {
  id           String         @id @default(uuid())
  instanceName String
  config       WppPilotConfig @relation(fields: [instanceName], references: [instanceName])

  phone           String             @default("")
  participantType WppParticipantType @default(UNKNOWN)
  
  tenantId        String? // Referência lógica
  stationId       String? // Referência lógica
  driverId        String? // Referência lógica
  addresseeId     String? // Referência lógica
  packId          String? // Referência lógica (Último pacote associado)

  state         WppConversationState @default(BOT_ACTIVE)
  lastMessageAt DateTime?
  totalMessages Int                  @default(0)

  // Dispatcher Humano
  dispatcherAtivo Boolean   @default(false)
  dispatcherNome  String?
  dispatcherSince DateTime?
  botSilenciado   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages           WppPilotMessage[]
  dispatcherSessions WppDispatcherSession[]

  @@unique([instanceName, phone])
  @@index([instanceName, state])
  @@index([tenantId])
  @@index([stationId])
  @@map("wpp_pilot_sessions")
}

// Mensagens individuais
model WppPilotMessage {
  id        String          @id @default(uuid())
  sessionId String
  session   WppPilotSession @relation(fields: [sessionId], references: [id])

  waMessageId    String? @unique
  direction      String
  messageType    String
  content        String? @db.Text
  isProxied      Boolean @default(false)
  proxySessionId String?

  deliveryStatus String @default("SENT")
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([waMessageId])
  @@map("wpp_pilot_messages")
}

// Canal proxy anonimo Agente <-> Destinatário
model WppProxyPilotSession {
  id           String         @id @default(uuid())
  instanceName String
  config       WppPilotConfig @relation(fields: [instanceName], references: [instanceName])
  tenantId     String
  stationId    String

  driverPhone       String
  driverId          String?
  addresseePhoneEnc String  // AES-256-GCM

  referenceId   String? // ID da Rota ou Pack
  
  status       WppProxyPilotStatus @default(ACTIVE)
  messageCount Int                 @default(0)
  expiresAt    DateTime
  endedAt      DateTime?
  endReason    String?

  createdAt DateTime             @default(now())
  auditLogs WppProxyPilotAudit[]

  @@index([instanceName, status])
  @@index([driverPhone])
  @@map("wpp_proxy_pilot_sessions")
}

// Audit log do proxy (apenas hash — LGPD)
model WppProxyPilotAudit {
  id             String               @id @default(uuid())
  proxySessionId String
  proxySession   WppProxyPilotSession @relation(fields: [proxySessionId], references: [id])

  direction   String
  messageHash String
  charCount   Int?
  createdAt   DateTime @default(now())

  @@index([proxySessionId])
  @@map("wpp_proxy_pilot_audit")
}

// Sessao de dispatcher humano
model WppDispatcherSession {
  id           String @id @default(uuid())
  instanceName String
  tenantId     String

  dispatcherId   String
  dispatcherNome String

  wppSessionId String
  wppSession   WppPilotSession @relation(fields: [wppSessionId], references: [id])

  ativo     Boolean   @default(true)
  entradaEm DateTime  @default(now())
  saidaEm   DateTime?

  mensagens WppDispatcherMsg[]

  @@index([wppSessionId, ativo])
  @@index([dispatcherId])
  @@map("wpp_dispatcher_sessions")
}

// Mensagens enviadas pelo dispatcher
model WppDispatcherMsg {
  id                  String               @id @default(uuid())
  dispatcherSessionId String
  dispatcherSession   WppDispatcherSession @relation(fields: [dispatcherSessionId], references: [id])

  waMessageId String? @unique
  content     String  @db.Text
  direction   String  @default("OUTBOUND")
  toPhone     String

  createdAt DateTime @default(now())

  @@index([dispatcherSessionId])
  @@map("wpp_dispatcher_msgs")
}

// Log de uso IA (Custo tokens)
model LlmUsageLog {
  id             String  @id @default(uuid())
  configId       String
  config         WppPilotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  
  provider     String  @db.VarChar(30)
  model        String  @db.VarChar(50)
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costUsd      Decimal @default(0) @db.Decimal(10, 6)
  
  success      Boolean @default(true)
  createdAt     DateTime @default(now())

  @@index([configId])
  @@map("llm_usage_logs")
}

model FluxoEntregaDestinatario {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  instanceName      String
  tenantId          String
  stationId         String
  packId            String // Referência lógica (Objeto/Pedido)
  addresseePhone    String
  addresseeName     String?

  status            StatusFluxoEntrega @default(AWAITING_RESPONSE)

  respostaRaw         String?
  opcaoEscolhida      String?
  expiresAt           DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([instanceName, status])
  @@index([packId])
  @@map("fluxo_entrega_destinatario")
}

model FluxoConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId  String
  stationId String?
  codigo    String
  versao    Int      @default(1)
  ativo     Boolean  @default(true)
  definicao Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, stationId, codigo])
  @@map("fluxo_configs")
}
