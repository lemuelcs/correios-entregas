# Database
DATABASE_URL="postgresql://usr_correiosentrega:Correios123@localhost:5432/correiosentrega_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-min-32-chars"

# Correios CWS
CORREIOS_CWS_URL="https://api.correios.com.br"
CORREIOS_CWS_USERNAME=""
CORREIOS_CWS_ACCESS_CODE=""
CORREIOS_CWS_CONTRACT=""
CORREIOS_CWS_CARTAO_POSTAGEM=""

# ViaCEP (fallback gratuito)
VIACEP_URL="https://viacep.com.br/ws"

# OSRM (self-hosted)
OSRM_URL="http://osrm:5000"

# VROOM (Docker)
VROOM_URL="http://vroom:3000"

# PyVRP (Docker FastAPI)
PYVRP_URL="http://pyvrp:8000"

# App
PORT=3002
NODE_ENV=development
FRONTEND_URL="http://localhost:5180"

# Upload (POD photos)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# WhatsApp Hub (via gateway delivyo-services / ms-whatsapp)
WHATSAPP_HUB_BASE_URL="http://host.docker.internal/services/whatsapp"
WHATSAPP_HUB_API_PREFIX="/api/comunicacao"
WHATSAPP_HUB_TIMEOUT_MS=10000
WHATSAPP_HUB_TENANT_ID="CORREIOS"
